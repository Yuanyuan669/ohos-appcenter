{
  "name": "ohos-appcenter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenHarmony 4.1/API 11 自建应用分发中心：索引 + 设备端 HAP + PC agent 安装闭环",
  "scripts": {
    "test": "node --test",
    "build:index": "node tools/build-index.mjs --store store",
    "validate": "node tools/validate-index.mjs --store store",
    "serve": "node tools/serve.mjs --store store --port 8787",
    "agent": "node agent/pc-agent.mjs --once",
    "agent:watch": "node agent/pc-agent.mjs --interval 5"
  },
  "engines": {
    "node": ">=20"
  }
}
